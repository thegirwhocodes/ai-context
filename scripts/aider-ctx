#!/bin/bash
# Aider (Claude architect + DeepSeek editor) wired into the ~/ai-context recovery system.
# Start: loads RECOVERY.md + this project's INDEX.md read-only. Exit: exports the redacted chat history and syncs to GitHub.
CTX="${AI_CONTEXT_DIR:-$HOME/ai-context}"
export PATH="$HOME/.local/bin:$PATH"
unset ANTHROPIC_BASE_URL ANTHROPIC_AUTH_TOKEN   # ~/.zshrc routes these via OpenRouter; aider uses the key in ~/.aider.conf.yml
[ -f ~/.zshrc ] && DEEPSEEK_API_KEY="${DEEPSEEK_API_KEY:-$(grep -oE '^export DEEPSEEK_API_KEY="[^"]+"' ~/.zshrc | cut -d'"' -f2)}" && export DEEPSEEK_API_KEY
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "aider-ctx: run inside a git repo" >&2; exit 1; }
grep -qxF "$ROOT" ~/.aider-roots 2>/dev/null || echo "$ROOT" >> ~/.aider-roots
git -C "$CTX" pull --ff-only -q 2>/dev/null
SLUG="$(python3 -c "import sys;sys.path.insert(0,'$CTX/scripts');import export_context as e;print(e.aider_slug(sys.argv[1]))" "$ROOT")"
# Small context brief (keeps Claude input cheap and stable): recent commits, recent human sessions
# (automation and aider runs skipped), and pointers to the full archive.
BRIEF="${TMPDIR:-/tmp}/aider-ctx-$SLUG.md"
python3 - "$CTX" "$SLUG" "$ROOT" > "$BRIEF" <<'PY'
import re, subprocess, sys
from pathlib import Path
ctx, slug, root = Path(sys.argv[1]), sys.argv[2], sys.argv[3]
proj = ctx / "projects" / slug
print(f"# Prior context: {slug}\n")
log = subprocess.run(["git", "-C", root, "log", "-15", "--format=%cs %s"], capture_output=True, text=True).stdout.strip()
if log:
    print("## Recent commits in this repo\n" + "\n".join(f"- {l}" for l in log.splitlines()) + "\n")
rows = []
for f in sorted(proj.glob("sessions/*/*.md"), key=lambda f: f.stat().st_mtime, reverse=True):
    if "/aider/" in str(f):
        continue
    t = f.read_text(errors="replace")
    m = re.search(r"^## Naomi · (\S+)\n\n(.+)", t, re.M)
    if not m or m.group(2).startswith(("Automation:", "<")):
        continue
    rows.append(f"- {m.group(1)[:10]} — {m.group(2)[:140]} ({f})")
    if len(rows) == 8:
        break
if rows:
    print("## Recent sessions (first request; /read-only a file for the full conversation)\n" + "\n".join(rows) + "\n")
docs = sorted(p.name for p in Path(root).glob("*.md") if not p.name.startswith(".aider"))
print(f"## Elsewhere\n- Repo docs (use /read-only): {', '.join(docs) or 'none'}\n- Archive: {proj}/ and {ctx}/RECOVERY.md")
PY
READS=(--read "$BRIEF")
for doc in AGENTS.md CLAUDE.md README.md; do [ -f "$ROOT/$doc" ] && READS+=(--read "$ROOT/$doc"); done
aider "${READS[@]}" "$@"
STATUS=$?
if [ -f "$ROOT/.aider.chat.history.md" ]; then
  python3 "$CTX/scripts/export_context.py" --transcript "$ROOT/.aider.chat.history.md" >/dev/null 2>&1 &&
    [ -z "$AIDER_CTX_NO_SYNC" ] && (nohup python3 "$CTX/scripts/sync_context.py" --no-export >/dev/null 2>&1 &)
fi
exit $STATUS

#!/bin/bash
# Aider (Claude architect + DeepSeek editor) wired into the ~/ai-context recovery system.
# Start: loads RECOVERY.md + this project's INDEX.md read-only. Exit: exports the redacted chat history and syncs to GitHub.
CTX="${AI_CONTEXT_DIR:-$HOME/ai-context}"
export PATH="$HOME/.local/bin:$PATH"
unset ANTHROPIC_BASE_URL ANTHROPIC_AUTH_TOKEN   # ~/.zshrc routes these via OpenRouter; aider uses the key in ~/.aider.conf.yml
[ -f ~/.zshrc ] && DEEPSEEK_API_KEY="${DEEPSEEK_API_KEY:-$(grep -oE '^export DEEPSEEK_API_KEY="[^"]+"' ~/.zshrc | cut -d'"' -f2)}" && export DEEPSEEK_API_KEY
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "aider-ctx: run inside a git repo" >&2; exit 1; }
grep -qxF "$ROOT" ~/.aider-roots 2>/dev/null || echo "$ROOT" >> ~/.aider-roots
git -C "$CTX" pull --ff-only -q 2>/dev/null
SLUG="$(python3 -c "import sys;sys.path.insert(0,'$CTX/scripts');import export_context as e;print(e.aider_slug(sys.argv[1]))" "$ROOT")"
# Small context brief (keeps Claude input cheap): pointer + this project's 8 most recent Claude/Codex sessions
# (aider rows excluded so the brief, and Claude's prompt cache, stay stable between aider runs).
BRIEF="${TMPDIR:-/tmp}/aider-ctx-$SLUG.md"
{ echo "# Prior context ($SLUG)"
  echo "Full archive: $CTX/RECOVERY.md and $CTX/projects/$SLUG/ (sessions, memory). /read-only a session file if you need it."
  [ -f "$CTX/projects/$SLUG/INDEX.md" ] && grep -v '| aider |' "$CTX/projects/$SLUG/INDEX.md" | sed -n '3,12p' | sed "s#](#]($CTX/projects/$SLUG/#"
} > "$BRIEF"
READS=(--read "$BRIEF")
aider "${READS[@]}" "$@"
STATUS=$?
if [ -f "$ROOT/.aider.chat.history.md" ]; then
  python3 "$CTX/scripts/export_context.py" --transcript "$ROOT/.aider.chat.history.md" >/dev/null 2>&1 &&
    [ -z "$AIDER_CTX_NO_SYNC" ] && (nohup python3 "$CTX/scripts/sync_context.py" --no-export >/dev/null 2>&1 &)
fi
exit $STATUS
